# ============================================
# IITB BAAP Agent - Resource Configuration
# ============================================
# Copy this file to .env and customize values for your workspace.
# These defaults point to the iitb.bharat_bricks schema on the free-edition workspace.

# ---------------------------------------------
# Databricks Authentication (for local development)
# ---------------------------------------------
DATABRICKS_CONFIG_PROFILE=free-edition

# ---------------------------------------------
# MLflow Configuration
# ---------------------------------------------
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_EXPERIMENT_ID=1568566937566223

# ---------------------------------------------
# Base namespace (catalog.schema)
# ---------------------------------------------
DATABRICKS_CATALOG=iitb
DATABRICKS_SCHEMA=bharat_bricks

# ---------------------------------------------
# Genie Space ID for analytics queries
# ---------------------------------------------
GENIE_SPACE_ID=01f135a25c7a1f63b039f802c37eaf5e

# ---------------------------------------------
# Vector Search Index (full three-level name)
# ---------------------------------------------
VECTOR_SEARCH_INDEX=iitb.bharat_bricks.vs_gold_posts_index

# ---------------------------------------------
# Model serving endpoint
# ---------------------------------------------
MODEL_ENDPOINT=databricks-gpt-oss-120b

# ---------------------------------------------
# Prompt Registry (format: prompts:/catalog.schema.prompt_name@alias)
# ---------------------------------------------
PROMPT_NAME=iitb_lingo_prompt
PROMPT_ALIAS=production
# Or set the full URI directly:
# PROMPT_REGISTRY_URI=prompts:/iitb.bharat_bricks.iitb_lingo_prompt@production

# ---------------------------------------------
# MLflow Experiment ID (for tracing)
# ---------------------------------------------
MLFLOW_EXPERIMENT_ID=1568566937566223
